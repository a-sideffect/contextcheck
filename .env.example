# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENALEX_API_KEY=

# Optional overrides. gemini-3.8-flash and 3.7-flash hung on our key, so these are the defaults.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_DAILY_CAP=100
GEMINI_MIN_INTERVAL=4
