# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENALEX_API_KEY=

# Optional overrides. Free tier limits each model per day: gemini-3.5-flash allowed only about 10 requests,
# so both tiers default to the lite model. gemini-3.8-flash and 3.7-flash hung on our key.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_DAILY_CAP=100
GEMINI_MIN_INTERVAL=4
